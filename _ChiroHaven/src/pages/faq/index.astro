---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = 'Clinical FAQ & Patient Information | Boston MA';
const description = 'Direct answers to common clinical questions about chiropractic care, physical therapy, insurance superbills, and appointment expectations in Boston.';

const breadcrumbs = [
  { name: 'Home', url: `${base}/` },
  { name: 'FAQ', url: `${base}/faq/` }
];

const faqs = [
  {
    q: 'Do I need a prescription or physician referral to receive treatment?',
    a: 'No. Massachusetts is a direct access state for both chiropractic care and physical therapy. You can be evaluated and treated directly without needing a referral or prescription from a medical doctor. If our clinical exam discovers signs of acute fracture, infection, or non-mechanical pathology, we immediately refer you to appropriate hospital imaging or orthopedic surgeons.'
  },
  {
    q: 'How does your out-of-network insurance billing work?',
    a: 'We are a fee-for-service clinic and do not bill commercial health insurers directly. Patients pay at the conclusion of each visit via credit card, debit card, or HSA/FSA card. We immediately email you a standardized itemized Superbill with ICD-10 diagnostic codes and CPT procedural codes, which you can submit to your insurance carrier for direct out-of-network reimbursement.'
  },
  {
    q: 'What should I wear to my initial physical therapy or chiropractic session?',
    a: 'Wear comfortable, loose-fitting athletic clothing such as shorts or leggings and a t-shirt or tank top. This allows our clinicians to clearly inspect spinal posture, palpate relevant joint segments, and perform active functional range-of-motion assessments without restriction.'
  },
  {
    q: 'Is chiropractic spinal manipulation safe?',
    a: 'Yes. Peer-reviewed clinical research published in journals such as Spine and the Annals of Internal Medicine consistently demonstrates that chiropractic adjustments are exceptionally safe when performed by licensed, board-certified doctors. Severe adverse events are exceedingly rare, estimated at less than 1 in several million manipulations.'
  },
  {
    q: 'What causes the "popping" sound during a joint adjustment?',
    a: 'The audible cavitation sound is caused by a rapid change in pressure within the synovial joint capsule. This pressure shift causes dissolved nitrogen gas bubbles within the synovial fluid to release. The sound is not bones cracking, grinding, or rubbing together.'
  },
  {
    q: 'How many sessions will I need before I feel better?',
    a: 'Most patients with acute mechanical neck or back pain experience noticeable symptom reduction within 2 to 4 sessions. Chronic issues or severe disc herniations typically require an initial 6 to 8-week corrective care plan consisting of 1 to 2 sessions per week. We never recommend indefinite care packages.'
  },
  {
    q: 'What is the clinic cancellation and rescheduling policy?',
    a: 'Because our appointments are 1-on-1 for 45 to 60 minutes with senior clinicians, we require at least 24 hours advance notice to cancel or reschedule without fee. Late cancellations within 24 hours incur a $50 administrative fee to cover clinician time.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a
    }
  }))
};
---

<BaseLayout title={title} description={description} extraSchema={faqSchema}>
  <Breadcrumbs items={breadcrumbs} />

  <section class="section">
    <div class="container">
      <div class="faq-header">
        <p class="section-eyebrow">Evidence & Transparency</p>
        <h1>Frequently Asked Clinical Questions</h1>
        <p class="section-lead">
          Everything you need to know about our medical procedures, insurance reimbursement, appointment preparation, and clinical philosophy.
        </p>
      </div>

      <div class="faq-accordion-list">
        {faqs.map((f, i) => (
          <details class="accordion-item" open={i === 0}>
            <summary>{f.q}</summary>
            <div class="accordion-content">
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="faq-help-banner">
        <h2>Still Have Questions About Your Condition?</h2>
        <p>
          Our clinical coordinators are available Monday through Friday from 8:00 AM to 6:00 PM to discuss your symptoms and match you with the right specialist.
        </p>
        <div class="faq-help-actions">
          <a href={`${base}/contact/`} class="btn btn-primary">
            Contact Clinical Coordinator
          </a>
          <a href="tel:6176232338" class="btn btn-secondary">
            Call (617) 623-2338
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-header {
    max-width: var(--max-measure);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .faq-accordion-list {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0 1.5rem;
    margin-bottom: 4rem;
  }

  .faq-help-banner {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: clamp(1.5rem, 4vw, 3rem);
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-help-banner h2 {
    margin-bottom: 0.75rem;
  }

  .faq-help-banner p {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 1.5rem;
  }

  .faq-help-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>

