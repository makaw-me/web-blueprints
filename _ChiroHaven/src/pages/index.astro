---
import BaseLayout from '../layouts/BaseLayout.astro';
import KineticSpineStory from '../components/KineticSpineStory.astro';
import PostureComparison from '../components/PostureComparison.astro';
import SymptomExplorer from '../components/SymptomExplorer.astro';
import InteractiveModalityShowcase from '../components/InteractiveModalityShowcase.astro';
import RecoveryRoadmap from '../components/RecoveryRoadmap.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = 'ChiroHaven | Boston Chiropractic & Physical Therapy';
const description = 'Evidence-based chiropractic care, physical therapy, and clinical pilates in Back Bay, Boston. Relieve chronic pain and restore mobility with licensed specialists.';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do I need a physician referral before booking chiropractic care?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'In Massachusetts, direct access laws allow patients to visit licensed chiropractors and physical therapists without a prior medical referral for initial evaluation and non-surgical conservative care.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do you accept health insurance or FSA/HSA cards?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We accept all Health Savings Accounts (HSA) and Flexible Spending Accounts (FSA). As an out-of-network clinic, we provide detailed, itemized Superbills with diagnostic codes for direct insurer reimbursement.'
      }
    },
    {
      '@type': 'Question',
      name: 'What happens during my initial clinical appointment?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Your 60-minute initial appointment includes a full orthopedic assessment, neurological and spinal range-of-motion screening, diagnosis explanation, and targeted first-day treatment.'
      }
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  extraSchema={faqSchema}
  preloadImage={`${base}/images/hero-rehabilitation.webp`}
>
  <!-- Story-Based Hero Section with Full-Bleed Banner & Live Telemetry -->
  <section class="hero-section hero-banner-section dark-section" aria-labelledby="hero-heading">
    <!-- Full-Bleed Hero Banner (Edge-to-Edge with photo backdrop strictly behind this banner, no enclosing boundary border) -->
    <div class="hero-fullbleed-banner">
      <div class="hero-fullbleed-backdrop" aria-hidden="true">
        <img
          src={`${base}/images/hero-rehabilitation.webp`}
          alt=""
          width="1920"
          height="901"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="hero-fullbleed-photo"
        />
        <div class="hero-fullbleed-tint"></div>
      </div>

      <div class="container hero-fullbleed-container">
        <div class="hero-fullbleed-content">
          <p class="hero-eyebrow">Back Bay Spine &amp; Sports Rehabilitation</p>
          <h1 id="hero-heading" class="hero-title">
            Specialized Chiropractic Care &amp; Physical Therapy in Boston
          </h1>
          <p class="hero-lead">
            Integrated spinal adjustments, joint mobilization, and clinical reformer pilates delivered by board-certified clinicians. We treat chronic pain, sciatica, and sports injuries without surgery.
          </p>

          <div class="hero-proof-bar">
            <span class="proof-item">&#10003; Board-Certified Clinicians</span>
            <span class="proof-item">&#10003; Same-Week Evaluations</span>
            <span class="proof-item">&#10003; FSA/HSA Accepted</span>
          </div>

          <div class="hero-actions">
            <a href={`${base}/contact/`} class="btn btn-primary">
              <span>Schedule Clinical Evaluation</span>
            </a>
            <button type="button" class="btn btn-secondary btn-watch-video" id="btn-open-video" aria-haspopup="dialog">
              <span class="play-icon-glyph" aria-hidden="true">&#9658;</span>
              <span>Watch Clinic Tour (1:05)</span>
            </button>
            <a href="tel:6176232338" class="hero-tel-link">
              <span>Or Call (617) 623-2338</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="container hero-lower-container">

      <!-- Animated Clinical Metrics Ribbon -->
      <div class="hero-metrics-ribbon double-bezel reveal-on-scroll">
        <div class="double-bezel-inner ribbon-inner">
          <div class="ribbon-stat-item">
            <span class="ribbon-number">14+</span>
            <span class="ribbon-label">Years of Orthopedic Practice</span>
          </div>
          <div class="ribbon-stat-item">
            <span class="ribbon-number">6,200+</span>
            <span class="ribbon-label">Spine & Joint Cases Treated</span>
          </div>
          <div class="ribbon-stat-item">
            <span class="ribbon-number">98%</span>
            <span class="ribbon-label">Patient Pain Reduction Rate</span>
          </div>
          <div class="ribbon-stat-item">
            <span class="ribbon-number">1-on-1</span>
            <span class="ribbon-label">Doctor Appointments (45–60 Min)</span>
          </div>
        </div>
      </div>

      <!-- Storytelling Video Modal Dialog -->
      <dialog id="clinic-video-dialog" class="video-dialog double-bezel" aria-labelledby="video-dialog-title">
        <div class="double-bezel-inner video-dialog-inner">
          <div class="video-dialog-header">
            <h3 id="video-dialog-title">Inside ChiroHaven: 60-Second Clinical Overview</h3>
            <button type="button" class="btn-close-video" id="btn-close-video" aria-label="Close video modal">✕</button>
          </div>

          <div class="video-player-container">
            <!-- Accessible video simulation with real poster and captions -->
            <video
              id="clinic-video-element"
              controls
              playsinline
              poster={`${base}/images/hero-rehabilitation.webp`}
              class="clinic-video-tag"
            >
              <source src={`${base}/images/clinic-facility-1.webp`} type="video/mp4" />
              <p>Your browser does not support HTML5 video. Please visit our clinic at 450 Boylston Street for an in-person facility tour.</p>
            </video>
          </div>

          <div class="video-dialog-footer">
            <p>
              <strong>Tour Highlights:</strong> High-velocity low-amplitude spinal adjustments, motorized Cox flexion-distraction disc decompression, and Balanced Body clinical reformer core training.
            </p>
            <a href={`${base}/contact/`} class="btn btn-primary btn-sm">
              <span>Schedule Initial Appointment</span>
            </a>
          </div>
        </div>
      </dialog>

      <!-- Storytelling Spine Interactive Telemetry Component -->
      <div class="hero-interactive-story reveal-on-scroll">
        <KineticSpineStory />
      </div>
    </div>
  </section>

  <!-- Interactive Symptom & Clinical Pathway Finder (One Live Thing) -->
  <section class="section triage-section" aria-labelledby="triage-heading">
    <div class="container">
      <div class="reveal-on-scroll">
        <SymptomExplorer />
      </div>
    </div>
  </section>

  <!-- Interactive Clinical Treatment Modalities Showcase -->
  <section class="section services-preview-section" aria-labelledby="services-overview-heading">
    <div class="container">
      <div class="section-intro reveal-on-scroll">
        <p class="section-eyebrow">Clinical Treatments</p>
        <h2 id="services-overview-heading">Evidence-Based Treatment Modalities</h2>
        <p class="section-lead">
          Every human spine and kinetic chain requires specific therapeutic interventions. Toggle between our clinical specialties below to explore treatment indications, session protocols, and recovery benchmarks:
        </p>
      </div>

      <!-- Interactive Tabbed Modality Showcase -->
      <div class="reveal-on-scroll">
        <InteractiveModalityShowcase />
      </div>

      <div class="services-all-cta reveal-on-scroll">
        <a href={`${base}/services/`} class="btn btn-secondary">
          <span>View All 4 Clinical Services & Fee Comparison</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 4-Phase Recovery Roadmap -->
  <section class="section roadmap-section" aria-labelledby="roadmap-overview-heading">
    <div class="container">
      <div class="section-intro reveal-on-scroll">
        <p class="section-eyebrow">Milestones-Based Care</p>
        <h2 id="roadmap-overview-heading">Your Pathway From Acute Pain to Movement Mastery</h2>
        <p class="section-lead">
          We believe in objective clinical progression with measurable milestones. Inspect each phase of your care journey below:
        </p>
      </div>

      <div class="reveal-on-scroll">
        <RecoveryRoadmap />
      </div>
    </div>
  </section>

  <!-- Clinical Quality & Philosophy + Interactive Posture Viewer -->
  <section class="section dark-section clinical-standards-section" aria-labelledby="standards-heading">
    <div class="container">
      <div class="standards-container">
        <div class="standards-text reveal-on-scroll">
          <p class="section-eyebrow dark-eyebrow">Our Clinical Philosophy</p>
          <h2 id="standards-heading">Treating the Root Mechanical Cause, Not Merely the Symptom</h2>
          <p>
            Too many healthcare facilities rush patients through 10-minute sessions or prescribe passive treatments that offer temporary relief. At ChiroHaven, our appointments are 1-on-1 with senior clinicians for 45 to 60 minutes.
          </p>
          <ul class="standards-list" role="list">
            <li><strong>Objective Diagnostic Assessment:</strong> Digital posture scans, orthopedic provocative testing, and functional movement screens before any adjustment.</li>
            <li><strong>Collaborative Cross-Discipline Care:</strong> Chiropractors, physical therapists, and pilates specialists confer directly on complex cases.</li>
            <li><strong>Transparent Patient Autonomy:</strong> Clear timelines, home stabilization exercises, and zero long-term sales contracts.</li>
          </ul>
          <div class="standards-action">
            <a href={`${base}/about/`} class="btn btn-primary">
              <span>Meet Our Clinical Staff</span>
            </a>
          </div>
        </div>

        <div class="standards-visual double-bezel reveal-on-scroll">
          <div class="double-bezel-inner">
            <img
              src={`${base}/images/clinical-reformer.webp`}
              alt="Instructor guiding a rehabilitation patient through guided reformer movements in clinic studio"
              width="550"
              height="400"
              loading="lazy"
              decoding="async"
              class="standards-image"
            />
          </div>
        </div>
      </div>

      <!-- Interactive Before/After Posture Alignment Visualizer -->
      <div class="reveal-on-scroll">
        <PostureComparison />
      </div>
    </div>
  </section>

  <!-- Clinician Team Spotlight -->
  <section class="section team-spotlight-section" aria-labelledby="team-heading">
    <div class="container">
      <div class="section-intro reveal-on-scroll">
        <p class="section-eyebrow">Licensed Clinicians</p>
        <h2 id="team-heading">Experienced Practitioners Committed to Your Care</h2>
        <p class="section-lead">
          Our providers hold doctorates and certifications from accredited medical and chiropractic universities, with specialized post-graduate training in spinal rehabilitation and sports medicine.
        </p>
      </div>

      <div class="team-grid">
        <div class="team-card double-bezel interactive-hover-lift reveal-on-scroll stagger-1">
          <div class="double-bezel-inner">
            <img
              src={`${base}/images/dr-benjamin-williams.webp`}
              alt="Dr. Benjamin Williams, Chiropractic Physician in clinical consultation room"
              width="320"
              height="320"
              loading="lazy"
              decoding="async"
              class="team-photo"
            />
            <div class="team-info">
              <h3 class="team-name">Dr. Benjamin Williams, DC</h3>
              <p class="team-role">Clinic Director & Chiropractic Physician</p>
              <p class="team-bio">
                14+ years clinical experience specializing in non-surgical spinal decompression, disc herniation rehabilitation, and complex postural correction.
              </p>
              <a href={`${base}/contact/`} class="team-direct-link">
                <span>Book With Dr. Williams</span> &rarr;
              </a>
            </div>
          </div>
        </div>

        <div class="team-card double-bezel interactive-hover-lift reveal-on-scroll stagger-2">
          <div class="double-bezel-inner">
            <img
              src={`${base}/images/sarah-miller-pt.webp`}
              alt="Sarah Miller, Doctor of Physical Therapy evaluating patient posture"
              width="320"
              height="320"
              loading="lazy"
              decoding="async"
              class="team-photo"
            />
            <div class="team-info">
              <h3 class="team-name">Sarah Miller, PT, DPT</h3>
              <p class="team-role">Lead Physical Therapist & Orthopedic Specialist</p>
              <p class="team-bio">
                Doctorate in Physical Therapy from Boston University. Expert in knee and shoulder biomechanics, runner gait retraining, and post-surgical recovery.
              </p>
              <a href={`${base}/contact/`} class="team-direct-link">
                <span>Book With Dr. Miller</span> &rarr;
              </a>
            </div>
          </div>
        </div>

        <div class="team-card double-bezel interactive-hover-lift reveal-on-scroll stagger-3">
          <div class="double-bezel-inner">
            <img
              src={`${base}/images/dr-elena-vance.webp`}
              alt="Dr. Elena Vance, Chiropractor and Clinical Pilates Instructor"
              width="320"
              height="320"
              loading="lazy"
              decoding="async"
              class="team-photo"
            />
            <div class="team-info">
              <h3 class="team-name">Dr. Elena Vance, DC, CPI</h3>
              <p class="team-role">Chiropractor & Certified Pilates Instructor</p>
              <p class="team-bio">
                Specializes in combining gentle joint adjustments with reformer core activation to manage scoliosis, perinatal pelvic pain, and desk worker posture fatigue.
              </p>
              <a href={`${base}/contact/`} class="team-direct-link">
                <span>Book With Dr. Vance</span> &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Verified Patient Outcomes & Clinical Reviews -->
  <section class="section reviews-section" aria-labelledby="reviews-heading">
    <div class="container">
      <div class="section-intro reveal-on-scroll">
        <p class="section-eyebrow">Patient Experiences</p>
        <h2 id="reviews-heading">Verified Recovery Outcomes &amp; Patient Testimonials</h2>
        <p class="section-lead">
          Real mechanical diagnoses, objective functional benchmarks, and long-term relief. Read how our collaborative clinical model helps Boston residents return to pain-free movement without surgery or dependency:
        </p>
      </div>

      <div class="reviews-grid">
        <!-- Review 1 -->
        <article class="review-card double-bezel interactive-hover-lift reveal-on-scroll stagger-1">
          <div class="double-bezel-inner review-inner">
            <div class="review-top-meta">
              <div class="patient-id">
                <span class="patient-name">Mark D.</span>
                <span class="patient-loc">Back Bay, Boston</span>
              </div>
              <span class="review-quote-icon" aria-hidden="true">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                </svg>
              </span>
            </div>

            <div class="clinical-case-tag">
              <span class="tag-label">Condition:</span>
              <strong>L4–L5 Disc Extrusion &amp; Severe Sciatica</strong>
            </div>

            <blockquote class="review-quote">
              <p>
                "After being told surgery was my only option for a severe L4–L5 disc herniation that left me unable to walk down Commonwealth Avenue without shooting leg pain, I consulted Dr. Williams. He explained the biomechanics clearly, never pushed a long-term sales package, and used motorized flexion-distraction tables. By week four, the numbness in my calf had receded. Today I am 100% pain-free and back in the gym."
              </p>
            </blockquote>

            <div class="review-footer-clinical">
              <div class="review-benchmark">
                <span class="benchmark-label">Clinical Benchmark:</span>
                <span class="benchmark-val">VAS 8/10 &rarr; 0/10 Pain &bull; Full Return to Gym</span>
              </div>
              <div class="review-provider">
                <span>Care Directed By:</span>
                <strong>Dr. Benjamin Williams, DC</strong>
              </div>
            </div>
          </div>
        </article>

        <!-- Review 2 -->
        <article class="review-card double-bezel interactive-hover-lift reveal-on-scroll stagger-2">
          <div class="double-bezel-inner review-inner">
            <div class="review-top-meta">
              <div class="patient-id">
                <span class="patient-name">Rebecca H.</span>
                <span class="patient-loc">South End, Boston</span>
              </div>
              <span class="review-quote-icon" aria-hidden="true">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                </svg>
              </span>
            </div>

            <div class="clinical-case-tag">
              <span class="tag-label">Condition:</span>
              <strong>Patellofemoral Knee Pain (Marathon Runner)</strong>
            </div>

            <blockquote class="review-quote">
              <p>
                "I had to drop out of marathon training twice because of sharp anterior knee pain that flared at mile 6. Sarah didn't just prescribe generic leg extensions; she recorded my running cadence on video and diagnosed severe glute medius weakness on my left side. The 1-on-1 sessions were rigorous, educational, and focused. I just completed the Boston Half Marathon with zero pain."
              </p>
            </blockquote>

            <div class="review-footer-clinical">
              <div class="review-benchmark">
                <span class="benchmark-label">Clinical Benchmark:</span>
                <span class="benchmark-val">Cadence 158 &rarr; 172 spm &bull; Pain-Free 13.1 Mi</span>
              </div>
              <div class="review-provider">
                <span>Care Directed By:</span>
                <strong>Sarah Miller, PT, DPT, OCS</strong>
              </div>
            </div>
          </div>
        </article>

        <!-- Review 3 -->
        <article class="review-card double-bezel interactive-hover-lift reveal-on-scroll stagger-3">
          <div class="double-bezel-inner review-inner">
            <div class="review-top-meta">
              <div class="patient-id">
                <span class="patient-name">Julian K.</span>
                <span class="patient-loc">Cambridge, MA</span>
              </div>
              <span class="review-quote-icon" aria-hidden="true">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                </svg>
              </span>
            </div>

            <div class="clinical-case-tag">
              <span class="tag-label">Condition:</span>
              <strong>Cervical Facet Strain &amp; Tension Headaches</strong>
            </div>

            <blockquote class="review-quote">
              <p>
                "Sitting at a financial trading desk 10 hours a day resulted in chronic occipital tension headaches three days a week. Combining gentle joint mobilization with clinical reformer pilates retrained my neck posture and deep spinal stabilizers. Dr. Vance also gave me simple workstation ergonomic adjustments that made a permanent difference."
              </p>
            </blockquote>

            <div class="review-footer-clinical">
              <div class="review-benchmark">
                <span class="benchmark-label">Clinical Benchmark:</span>
                <span class="benchmark-val">0 Headaches in 90 Days &bull; +35% Neck Rotation</span>
              </div>
              <div class="review-provider">
                <span>Care Directed By:</span>
                <strong>Dr. Elena Vance, DC, CPI</strong>
              </div>
            </div>
          </div>
        </article>
      </div>

      <!-- Trust Standards Footer Bar -->
      <div class="reviews-trust-bar double-bezel reveal-on-scroll">
        <div class="double-bezel-inner trust-bar-inner">
          <div class="trust-pill">
            <span class="trust-icon" aria-hidden="true">&#10003;</span>
            <span><strong>Strict 1-on-1 Sessions:</strong> Never handed off to clinical aides or techs</span>
          </div>
          <div class="trust-pill">
            <span class="trust-icon" aria-hidden="true">&#10003;</span>
            <span><strong>Objective 4-Week Re-exams:</strong> Standardized Oswestry &amp; LEFS functional tracking</span>
          </div>
          <div class="trust-pill">
            <span class="trust-icon" aria-hidden="true">&#10003;</span>
            <span><strong>Ethical Billing:</strong> Transparent self-pay fees, itemized Superbills, zero sales contracts</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Evidence & Case Studies Preview -->
  <section class="section case-studies-section" aria-labelledby="cases-heading">
    <div class="container">
      <div class="section-intro reveal-on-scroll">
        <p class="section-eyebrow">Documented Outcomes</p>
        <h2 id="cases-heading">Real Clinical Case Studies & Functional Recovery</h2>
        <p class="section-lead">
          We track verifiable orthopedic indicators: visual analogue pain scale (VAS), active range of motion, and Oswestry Disability Index scores across care plans.
        </p>
      </div>

      <div class="case-study-feature double-bezel reveal-on-scroll">
        <div class="double-bezel-inner case-study-inner-grid">
          <div class="case-study-visual">
            <img
              src={`${base}/images/case-study-decompression.webp`}
              alt="Anatomical spine lumbar model showing L4-L5 disc decompression mechanics"
              width="500"
              height="340"
              loading="lazy"
              decoding="async"
              class="case-image"
            />
          </div>
          <div class="case-study-text">
            <span class="case-tag">Orthopedic Case Study #01</span>
            <h3>Lumbar L4-L5 Disc Herniation with Unilateral Radiculopathy</h3>
            <p>
              A 42-year-old financial software analyst presented with severe radiating pain down the left leg (VAS 8/10) following long desk sessions. MRI confirmed an extruded disc fragment without motor deficit.
            </p>
            <ul class="case-points" role="list">
              <li><strong>Protocol:</strong> 6 weeks flexion-distraction spinal decompression paired with clinical reformer transverse abdominis activation.</li>
              <li><strong>Outcome:</strong> Radicular leg pain abolished (VAS 1/10). Returned to full 8-hour workday and running without surgical intervention.</li>
            </ul>
            <a href={`${base}/case-studies/spinal-decompression-lumbar-herniation/`} class="btn btn-primary">
              <span>Read Complete 8-Week Case Documentation</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Accordion (Answer-first AEO) -->
  <section class="section faq-section" aria-labelledby="faq-home-heading">
    <div class="container">
      <div class="section-intro reveal-on-scroll">
        <p class="section-eyebrow">Direct Answers</p>
        <h2 id="faq-home-heading">Frequently Asked Clinical Questions</h2>
        <p class="section-lead">
          Straightforward answers to the most common questions regarding clinical assessments, billing, insurance, and treatment safety.
        </p>
      </div>

      <div class="faq-accordion-group double-bezel reveal-on-scroll">
        <div class="double-bezel-inner">
          <details class="accordion-item" open>
            <summary>Do I need a physician referral before booking chiropractic care?</summary>
            <div class="accordion-content">
              <p>
                In Massachusetts, direct access laws allow patients to visit licensed chiropractors and physical therapists without a prior medical referral for initial evaluation and non-surgical conservative care. If your clinical examination reveals conditions requiring surgical or specialized imaging review, we coordinate directly with your primary care provider.
              </p>
            </div>
          </details>

          <details class="accordion-item">
            <summary>Do you accept health insurance or FSA/HSA cards?</summary>
            <div class="accordion-content">
              <p>
                We accept all Health Savings Accounts (HSA) and Flexible Spending Accounts (FSA). As an out-of-network clinic, we provide detailed, itemized Superbills with diagnostic codes for direct insurer reimbursement. This fee-for-service model ensures your care is directed solely by clinical need rather than restrictive insurer limits.
              </p>
            </div>
          </details>

          <details class="accordion-item">
            <summary>What happens during my initial clinical appointment?</summary>
            <div class="accordion-content">
              <p>
                Your 60-minute initial appointment includes a full orthopedic assessment, neurological and spinal range-of-motion screening, diagnosis explanation, and targeted first-day treatment. You receive an honest prognosis and customized rehabilitation roadmap at the end of the session.
              </p>
            </div>
          </details>

          <details class="accordion-item">
            <summary>Are chiropractic adjustments safe for neck and back pain?</summary>
            <div class="accordion-content">
              <p>
                When administered by licensed Chiropractic Physicians following orthopedic evaluation, spinal manipulation is recognized as one of the safest conservative interventions for mechanical neck and back disorders according to the American College of Physicians guidelines.
              </p>
            </div>
          </details>
        </div>
      </div>

      <div class="faq-footer-link reveal-on-scroll">
