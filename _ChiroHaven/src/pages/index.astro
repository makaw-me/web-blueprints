<script is:inline>
  (function() {
    const dialog = document.getElementById('clinic-video-dialog');
    const btnOpen = document.getElementById('btn-open-video');
    const btnPlayOverlay = document.getElementById('btn-hero-play-overlay');
    const btnClose = document.getElementById('btn-close-video');
    const video = document.getElementById('clinic-video-element');

    function openModal() {
      if (dialog && typeof dialog.showModal === 'function') {
        dialog.showModal();
        if (video) video.play().catch(() => {});
      } else if (dialog) {
        dialog.style.display = 'block';
      }
    }

    function closeModal() {
      if (video) video.pause();
      if (dialog && typeof dialog.close === 'function') {
        dialog.close();
      } else if (dialog) {
        dialog.style.display = 'none';
      }
    }

    if (btnOpen) btnOpen.addEventListener('click', openModal);
    if (btnPlayOverlay) btnPlayOverlay.addEventListener('click', openModal);
    if (btnClose) btnClose.addEventListener('click', closeModal);

    if (dialog) {
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) closeModal();
      });
    }
  })();
</script>
