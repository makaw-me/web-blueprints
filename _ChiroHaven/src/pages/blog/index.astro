---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = 'Spine & Mobility Health Guides | ChiroHaven Boston';
const description = 'Read clinical guides, posture ergonomics advice, and evidence-based rehabilitation strategies written by our doctors and physical therapists in Boston.';

const breadcrumbs = [
  { name: 'Home', url: `${base}/` },
  { name: 'Patient Guides', url: `${base}/blog/` }
];
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={breadcrumbs} />

  <section class="section">
    <div class="container">
      <div class="blog-header">
        <p class="section-eyebrow">Patient Education</p>
        <h1>Spine Health & Physical Wellness Resources</h1>
        <p class="section-lead">
          Actionable, evidence-based health guides written directly by our clinical staff. Learn how to prevent injury, optimize desk ergonomics, and maintain lifelong mobility.
        </p>
      </div>

      <div class="articles-grid">
        <!-- Featured Article 1 (Fully built) -->
        <article class="article-card">
          <div class="article-card-media">
            <img
              src={`${base}/images/mobility-exercise.webp`}
              alt="Person performing thoracic spine mobility exercise on mat"
              width="400"
              height="240"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="article-card-body">
            <div class="article-meta">
              <span>Ergonomics & Posture</span>
              <span>•</span>
              <span>6 min read</span>
            </div>
            <h2>Preventing Desk Fatigue: A Biomechanical Guide to Cervical Spine Health</h2>
            <p>
              Prolonged sitting places up to 60 pounds of cumulative stress on the cervical spine. Learn the exact 5-minute movement sequence to decompress facet joints during your workday.
            </p>
            <a href={`${base}/blog/preventing-desk-fatigue-spine-mobility/`} class="article-read-link">
              Read Complete Guide &rarr;
            </a>
          </div>
        </article>

        <!-- Article 2 (Sample overview) -->
        <article class="article-card">
          <div class="article-card-media">
            <img
              src={`${base}/images/clinic-facility-2.webp`}
              alt="Therapist demonstrating spine extension stretch on treatment table"
              width="400"
              height="240"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="article-card-body">
            <div class="article-meta">
              <span>Sports Rehabilitation</span>
              <span>•</span>
              <span>8 min read</span>
            </div>
            <h2>Understanding Sciatica: Why Stretching Your Hamstring Might Be Making It Worse</h2>
            <p>
              When nerve roots are irritated at L5-S1, aggressive forward bending stretches can stretch the inflamed sciatic nerve instead of lengthening muscle fibers. Learn how to nerve glide safely.
            </p>
            <p class="coming-note">Clinical guide available at Boston clinic reception.</p>
          </div>
        </article>

        <!-- Article 3 (Sample overview) -->
        <article class="article-card">
          <div class="article-card-media">
            <img
              src={`${base}/images/clinic-facility-3.webp`}
              alt="Patient exercising on clinical pilates reformer for lumbar core stabilization"
              width="400"
              height="240"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="article-card-body">
            <div class="article-meta">
              <span>Movement Medicine</span>
              <span>•</span>
              <span>5 min read</span>
            </div>
            <h2>The Role of Clinical Reformer Pilates in Chronic Low Back Rehabilitation</h2>
            <p>
              Why variable spring resistance creates the ideal environment for retraining the multifidus and transverse abdominis without compressive spinal loading.
            </p>
            <p class="coming-note">Clinical guide available at Boston clinic reception.</p>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-header {
    max-width: var(--max-measure);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 860px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .article-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .article-card-media {
    height: 200px;
    background: #eef3f0;
  }

  .article-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .article-meta {
    font-size: 0.8125rem;
    color: var(--color-primary);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .article-card-body h2 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .article-card-body p {
    font-size: 0.9375rem;
    margin-bottom: 1.25rem;
  }

  .article-read-link {
    margin-top: auto;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .coming-note {
    font-size: 0.8125rem !important;
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: auto;
  }
</style>

