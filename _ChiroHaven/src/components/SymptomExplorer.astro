---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="symptom-explorer-widget" id="symptom-interactive-finder" aria-label="Clinical Pathway Finder">
  <div class="finder-header">
    <p class="section-eyebrow">Personalized Triage</p>
    <h2>Interactive Clinical Pathway Finder</h2>
    <p class="finder-lead">
      Select your primary symptom profile to inspect the mechanical root cause, the proven intervention sequence, and the right specialist at our Boston clinic:
    </p>
  </div>

  <div class="finder-layout">
    <!-- Symptom Buttons (Thumb-friendly on mobile, structured on desktop) -->
    <div class="symptom-selector-list" role="radiogroup" aria-label="Symptom profiles">
      <button
        type="button"
        class="symptom-btn active"
        data-symptom="sciatica"
        role="radio"
        aria-checked="true"
      >
        <span class="btn-indicator" aria-hidden="true"></span>
        <span class="btn-text">
          <strong>Sciatica & Radiating Leg Pain</strong>
          <small>Sharp shooting pain or numbness past knee</small>
        </span>
      </button>

      <button
        type="button"
        class="symptom-btn"
        data-symptom="desk-neck"
        role="radio"
        aria-checked="false"
      >
        <span class="btn-indicator" aria-hidden="true"></span>
        <span class="btn-text">
          <strong>Desk Fatigue & Cervical Neck Stiffness</strong>
          <small>Forward-head tension, upper trap spasms</small>
        </span>
      </button>

      <button
        type="button"
        class="symptom-btn"
        data-symptom="core-instability"
        role="radio"
        aria-checked="false"
      >
        <span class="btn-indicator" aria-hidden="true"></span>
        <span class="btn-text">
          <strong>Chronic Lumbar Instability & Back Weakness</strong>
          <small>Aching during sit-to-stand, posture collapse</small>
        </span>
      </button>

      <button
        type="button"
        class="symptom-btn"
        data-symptom="shoulder"
        role="radio"
        aria-checked="false"
      >
        <span class="btn-indicator" aria-hidden="true"></span>
        <span class="btn-text">
          <strong>Shoulder Impingement & Rotator Cuff</strong>
          <small>Pain with overhead reaching or lying on arm</small>
        </span>
      </button>

      <button
        type="button"
        class="symptom-btn"
        data-symptom="headaches"
        role="radio"
        aria-checked="false"
      >
        <span class="btn-indicator" aria-hidden="true"></span>
        <span class="btn-text">
          <strong>Cervicogenic Tension Headaches</strong>
          <small>Throbbing band behind eyes and base of skull</small>
        </span>
      </button>
    </div>

    <!-- Triage Result Card -->
    <div class="pathway-card" id="pathway-result-card" aria-live="polite">
      <div class="pathway-badge" id="pathway-badge">Orthopedic Pathway: Lumbar Radiculopathy</div>
      <h3 class="pathway-title" id="pathway-title">Targeted Non-Surgical Disc Decompression</h3>

      <div class="pathway-grid">
        <div class="pathway-box">
          <span class="box-label">Biomechanical Diagnosis</span>
          <p id="pathway-diagnosis">L4-L5 / L5-S1 nerve root compression secondary to posterior annular disc protrusion.</p>
        </div>
        <div class="pathway-box">
          <span class="box-label">Targeted Therapy</span>
          <p id="pathway-therapy">Motorized Cox flexion-distraction traction + transverse abdominis stabilization.</p>
        </div>
      </div>

      <div class="pathway-meta-row">
        <div>
          <span class="meta-title">Lead Clinician:</span>
          <span class="meta-val" id="pathway-clinician">Dr. Benjamin Williams, DC</span>
        </div>
        <div>
          <span class="meta-title">Expected Phase-1 Relief:</span>
          <span class="meta-val" id="pathway-timeline">2 to 4 Weeks (4–6 sessions)</span>
        </div>
      </div>

      <div class="pathway-cta">
        <a href={`${base}/contact/`} class="btn btn-primary" id="pathway-action-btn">
          Schedule Initial Evaluation for Sciatica
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const pathways = {
      sciatica: {
        badge: 'Orthopedic Pathway: Lumbar Radiculopathy',
        title: 'Targeted Non-Surgical Disc Decompression',
        diagnosis: 'L4-L5 / L5-S1 nerve root compression secondary to posterior annular disc protrusion or facet entrapment.',
        therapy: 'Motorized Cox flexion-distraction traction + transverse abdominis stabilization.',
        clinician: 'Dr. Benjamin Williams, DC',
        timeline: '2 to 4 Weeks (4–6 sessions)',
        btnText: 'Schedule Initial Evaluation for Sciatica'
      },
      'desk-neck': {
        badge: 'Postural Pathway: Cervical Strain',
        title: 'Cervical Spine Realignment & Ergonomic Reset',
        diagnosis: 'Forward head posture placing 40+ lbs of continuous shear load on C5-C7 motion segments.',
        therapy: 'Gentle cervical facet joint mobilization + deep neck flexor neuromuscular retraining.',
        clinician: 'Dr. Benjamin Williams, DC & Sarah Miller, PT',
        timeline: '1 to 3 Weeks (3–5 sessions)',
        btnText: 'Book Cervical Spine Evaluation'
      },
      'core-instability': {
        badge: 'Rehabilitation Pathway: Lumbopelvic',
        title: 'Clinical Reformer Deep Stabilizer Program',
        diagnosis: 'Multifidus atrophy and delayed transversus abdominis firing causing recurrent lumbar micro-instability.',
        therapy: 'Spring-calibrated clinical reformer pilates + pelvic floor breath coordination.',
        clinician: 'Dr. Elena Vance, DC, CPI',
        timeline: '4 to 6 Weeks (6–8 sessions)',
        btnText: 'Explore Reformer Stabilization'
      },
      shoulder: {
        badge: 'Orthopedic Pathway: Sports & Shoulder',
        title: 'Scapulothoracic Mechanics & Rotator Cuff Loading',
        diagnosis: 'Subacromial impingement with weak posterior rotator cuff and scapular dyskinesis.',
        therapy: 'Progressive eccentric tendon loading + serratus anterior activation + joint mobilization.',
        clinician: 'Sarah Miller, PT, DPT (Orthopedic Specialist)',
        timeline: '3 to 6 Weeks (6–9 sessions)',
        btnText: 'Schedule Physical Therapy Assessment'
      },
      headaches: {
        badge: 'Neuromuscular Pathway: Cranial Tension',
        title: 'Upper Cervical Decompression & Trigger Point Release',
        diagnosis: 'Hypertonic suboccipital triangle muscles irritating the greater occipital nerve (C2 nerve root).',
        therapy: 'Active Myofascial Release (IASTM) + C1-C2 atlas-axis adjustment + postural display adjustment.',
        clinician: 'Dr. Benjamin Williams, DC',
        timeline: '1 to 2 Weeks (2–4 sessions)',
        btnText: 'Book Headache Assessment'
      }
    };

    const root = document.getElementById('symptom-interactive-finder');
    if (!root) return;

    const btns = root.querySelectorAll('.symptom-btn');
    const badge = document.getElementById('pathway-badge');
    const title = document.getElementById('pathway-title');
    const diag = document.getElementById('pathway-diagnosis');
    const ther = document.getElementById('pathway-therapy');
    const doc = document.getElementById('pathway-clinician');
    const time = document.getElementById('pathway-timeline');
    const btn = document.getElementById('pathway-action-btn');

    btns.forEach((b) => {
      b.addEventListener('click', () => {
        const key = b.getAttribute('data-symptom');
        if (!key || !pathways[key]) return;

        btns.forEach((x) => {
          x.classList.remove('active');
          x.setAttribute('aria-checked', 'false');
        });
        b.classList.add('active');
        b.setAttribute('aria-checked', 'true');

        const p = pathways[key];
        badge.textContent = p.badge;
        title.textContent = p.title;
        diag.textContent = p.diagnosis;
        ther.textContent = p.therapy;
        doc.textContent = p.clinician;
        time.textContent = p.timeline;
        btn.textContent = p.btnText;
      });
    });
  })();
</script>

<style>
  .symptom-explorer-widget {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: clamp(1.5rem, 4vw, 3rem);
    margin: 3.5rem 0;
    box-shadow: 0 4px 20px rgba(12, 34, 31, 0.05);
  }

  .finder-header {
    max-width: var(--max-measure);
    margin-bottom: 2rem;
  }

  .finder-header h2 {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    margin-bottom: 0.5rem;
  }

  .finder-lead {
    font-size: 1.05rem;
    color: var(--color-text-muted);
  }

  .finder-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .finder-layout {
      grid-template-columns: 1.15fr 1fr;
      gap: 2.5rem;
    }
  }

  .symptom-selector-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .symptom-btn {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    background: var(--color-surface-subtle);
    border: 2px solid var(--color-border);
    border-radius: 6px;
    text-align: left;
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    min-height: 56px;
    width: 100%;
  }

  .symptom-btn:hover {
    background: #e9f0ec;
    border-color: var(--color-border-strong);
    transform: translateX(4px);
  }

  .symptom-btn.active {
    background: #0c221f;
    border-color: #0c221f;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(12, 34, 31, 0.2);
    transform: translateX(6px);
  }

  .btn-indicator {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--color-border-strong);
    background: #ffffff;
    flex-shrink: 0;
  }

  .symptom-btn.active .btn-indicator {
    border-color: #ffffff;
    background: var(--color-dark-focus);
    box-shadow: 0 0 0 2px #0c221f;
  }

  .btn-text {
    display: flex;
    flex-direction: column;
  }

  .btn-text strong {
    font-size: 0.95rem;
    font-weight: 700;
  }

  .btn-text small {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .symptom-btn.active .btn-text small {
    color: #cde0d9;
  }

  /* Pathway Result Card */
  .pathway-card {
    background: #fafcfb;
    border: 1.5px solid var(--color-border);
    border-radius: 6px;
    padding: clamp(1.25rem, 3.5vw, 2rem);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pathway-badge {
    display: inline-block;
    align-self: flex-start;
    background: #e4eee8;
    color: #12332c;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }

  .pathway-title {
    font-size: 1.35rem;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .pathway-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .pathway-box {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.85rem 1rem;
  }

  .box-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-primary);
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .pathway-box p {
    font-size: 0.9375rem;
    line-height: 1.5;
    margin-bottom: 0;
  }

  .pathway-meta-row {
    background: var(--color-surface-subtle);
    border-radius: 4px;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .meta-title {
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .meta-val {
    font-weight: 700;
    color: var(--color-text);
  }

  .pathway-cta {
    margin-top: auto;
  }

  .pathway-cta .btn {
    width: 100%;
    text-align: center;
  }
</style>

