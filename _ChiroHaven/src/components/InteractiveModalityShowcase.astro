---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="modality-showcase-container double-bezel" id="modality-showcase" aria-label="Interactive Clinical Modalities Explorer">
  <div class="double-bezel-inner">
    <div class="modality-nav-bar" role="tablist" aria-label="Clinical treatment modalities">
      <button
        type="button"
        role="tab"
        class="modality-tab active"
        id="tab-chiro"
        data-modality="chiro"
        aria-selected="true"
        aria-controls="panel-modality-content"
      >
        <span class="tab-number">01</span>
        <span class="tab-label">Chiropractic Therapy</span>
      </button>

      <button
        type="button"
        role="tab"
        class="modality-tab"
        id="tab-pt"
        data-modality="pt"
        aria-selected="false"
        aria-controls="panel-modality-content"
      >
        <span class="tab-number">02</span>
        <span class="tab-label">Physical Therapy</span>
      </button>

      <button
        type="button"
        role="tab"
        class="modality-tab"
        id="tab-pilates"
        data-modality="pilates"
        aria-selected="false"
        aria-controls="panel-modality-content"
      >
        <span class="tab-number">03</span>
        <span class="tab-label">Clinical Pilates</span>
      </button>

      <button
        type="button"
        role="tab"
        class="modality-tab"
        id="tab-softtissue"
        data-modality="softtissue"
        aria-selected="false"
        aria-controls="panel-modality-content"
      >
        <span class="tab-number">04</span>
        <span class="tab-label">Soft Tissue & Fascia</span>
      </button>
    </div>

    <!-- Active Modality Showcase Card -->
    <div
      class="modality-content-panel"
      id="panel-modality-content"
      role="tabpanel"
      aria-labelledby="tab-chiro"
      aria-live="polite"
    >
      <div class="modality-card-grid">
        <div class="modality-visual-col">
          <div class="modality-image-wrap">
            <img
              id="modality-img"
              src={`${base}/images/service-chiropractic.webp`}
              alt="Doctor performing spinal palpation and gentle thoracic adjustment"
              width="540"
              height="360"
              loading="lazy"
              decoding="async"
              class="modality-photo"
            />
            <div class="modality-badge-overlay" id="modality-badge-overlay">
              <span class="badge-icon">✓</span>
              <span id="modality-badge-text">Physician Administered</span>
            </div>
          </div>
        </div>

        <div class="modality-info-col">
          <span class="modality-kicker" id="modality-kicker">Joint Kinematics & Nerve Decompression</span>
          <h3 class="modality-title" id="modality-title">Gentle Spinal Manipulation & Flexion-Distraction</h3>
          
          <p class="modality-lead" id="modality-lead">
            Targeted high-velocity, low-amplitude (HVLA) adjustments and motorized table decompression designed to restore restricted facet joints, relieve nerve root impingement, and abolish radiating sciatica.
          </p>

          <div class="modality-spec-grid">
            <div class="spec-item">
              <span class="spec-label">Session Duration</span>
              <span class="spec-value" id="modality-duration">45–60 Min (Eval) / 30 Min (Follow-up)</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">Clinical Outcome Benchmark</span>
              <span class="spec-value" id="modality-benchmark">85% Pain Reduction at 4 Weeks</span>
            </div>
          </div>

          <div class="modality-indications-wrap">
            <span class="indications-label">Primary Indications:</span>
            <div class="indications-pills" id="modality-indications">
              <span class="indication-pill">Disc Herniation</span>
              <span class="indication-pill">Sciatic Nerve Pain</span>
              <span class="indication-pill">Cervical Stiffness</span>
              <span class="indication-pill">Facet Syndrome</span>
            </div>
          </div>

          <div class="modality-cta-row">
            <a href={`${base}/services/chiropractic-therapy/`} class="btn btn-primary" id="modality-link">
              <span id="modality-link-text">Read Chiropractic Clinical Protocol</span>
            </a>
            <a href={`${base}/contact/`} class="btn btn-secondary">
              <span>Schedule Initial Visit</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ base }}>
  (function() {
    const modalities = {
      chiro: {
        title: 'Gentle Spinal Manipulation & Flexion-Distraction',
        kicker: 'Joint Kinematics & Nerve Decompression',
        lead: 'Targeted high-velocity, low-amplitude (HVLA) adjustments and motorized table decompression designed to restore restricted facet joints, relieve nerve root impingement, and abolish radiating sciatica.',
        imgSrc: `${base}/images/service-chiropractic.webp`,
        imgAlt: 'Doctor performing spinal palpation and gentle thoracic adjustment',
        badge: 'Physician Administered',
        duration: '45–60 Min (Eval) / 30 Min (Follow-up)',
        benchmark: '85% Pain Reduction at 4 Weeks',
        indications: ['Disc Herniation', 'Sciatic Nerve Pain', 'Cervical Stiffness', 'Facet Syndrome'],
        linkHref: `${base}/services/chiropractic-therapy/`,
        linkText: 'Read Chiropractic Clinical Protocol'
      },
      pt: {
        title: 'Orthopedic Rehabilitation & Progressive Neuromuscular Loading',
        kicker: 'Functional Kinetics & Injury Recovery',
        lead: 'Evidence-based exercise prescription, eccentric tendon loading, joint mobilization, and gait retraining to rehabilitate post-surgical deficits, rotator cuff injuries, and patellofemoral tracking disorders.',
        imgSrc: `${base}/images/service-physiotherapy.webp`,
        imgAlt: 'Physical therapist evaluating shoulder joint mobility and range of motion',
        badge: 'Doctorate in Physical Therapy',
        duration: '60 Min (Eval) / 45 Min (Treatment)',
        benchmark: 'Full Functional Return at 6–8 Weeks',
        indications: ['Rotator Cuff Tears', 'Post-Op ACL Recovery', 'Runner Knee Instability', 'Ankle Sprains'],
        linkHref: `${base}/services/physiotherapy/`,
        linkText: 'Explore Physical Therapy Protocols'
      },
      pilates: {
        title: 'Spring-Calibrated Reformer Core & Spine Stabilization',
        kicker: 'Deep Core Cylinders & Posture Alignment',
        lead: '1-on-1 clinician-guided reformer workouts using calibrated spring resistance to activate the transversus abdominis, multifidus, and pelvic diaphragm without compressive spinal shear.',
        imgSrc: `${base}/images/service-clinical-pilates.webp`,
        imgAlt: 'Patient working on clinical reformer under direction of certified therapist',
        badge: 'Certified Clinical Pilates',
        duration: '50 Minutes 1-on-1',
        benchmark: '100% Core Endurance Rebuilt',
        indications: ['Chronic Lower Back Pain', 'Postpartum Core Weakness', 'Scoliosis Management', 'Pelvic Instability'],
        linkHref: `${base}/services/clinical-pilates/`,
        linkText: 'Explore Clinical Pilates Reformer'
      },
      softtissue: {
        title: 'Instrument-Assisted Mobilization (IASTM) & Myofascial Release',
        kicker: 'Fascial Sliding & Scar Breakdown',
        lead: 'Targeted titanium-tool soft tissue mobilization and active trigger-point compression to dissolve stubborn scar adhesions, stimulate localized micro-circulation, and release severe muscle spasms.',
        imgSrc: `${base}/images/service-soft-tissue.webp`,
        imgAlt: 'Therapist executing deep soft-tissue trigger point release on upper trapezius',
        badge: 'Licensed Manual Specialist',
        duration: '30–45 Minutes',
        benchmark: 'Immediate Hypertonic Release',
        indications: ['Upper Trap Spasms', 'Plantar Fasciitis', 'Tennis / Golfer Elbow', 'Tension Headaches'],
        linkHref: `${base}/services/soft-tissue-therapy/`,
        linkText: 'Explore Soft Tissue Therapy'
      }
    };

    const container = document.getElementById('modality-showcase');
    if (!container) return;

    const tabs = container.querySelectorAll('.modality-tab');
    const panel = document.getElementById('panel-modality-content');
    const imgEl = document.getElementById('modality-img');
    const badgeEl = document.getElementById('modality-badge-text');
    const kickerEl = document.getElementById('modality-kicker');
    const titleEl = document.getElementById('modality-title');
    const leadEl = document.getElementById('modality-lead');
    const durationEl = document.getElementById('modality-duration');
    const benchmarkEl = document.getElementById('modality-benchmark');
    const indicationsEl = document.getElementById('modality-indications');
    const linkEl = document.getElementById('modality-link');
    const linkTextEl = document.getElementById('modality-link-text');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const modKey = tab.getAttribute('data-modality');
        if (!modKey || !modalities[modKey]) return;

        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        panel.setAttribute('aria-labelledby', tab.id);

        const data = modalities[modKey];
        imgEl.setAttribute('src', data.imgSrc);
        imgEl.setAttribute('alt', data.imgAlt);
        badgeEl.textContent = data.badge;
        kickerEl.textContent = data.kicker;
        titleEl.textContent = data.title;
        leadEl.textContent = data.lead;
        durationEl.textContent = data.duration;
        benchmarkEl.textContent = data.benchmark;

        // Render indication pills
        indicationsEl.innerHTML = '';
        data.indications.forEach((ind) => {
          const pill = document.createElement('span');
          pill.className = 'indication-pill';
          pill.textContent = ind;
          indicationsEl.appendChild(pill);
        });

        linkEl.setAttribute('href', data.linkHref);
        linkTextEl.textContent = data.linkText;
      });
    });
  })();
</script>

<style>
  .modality-showcase-container {
    margin: 2rem 0;
  }

  .modality-nav-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.5rem;
    margin-bottom: 2rem;
  }

  .modality-tab {
    background: transparent;
    border: none;
    padding: 0.75rem 1.25rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 6px;
    transition: all var(--transition-fast);
  }

  .modality-tab:hover {
    color: var(--color-text);
    background-color: var(--color-surface-subtle);
  }

  .modality-tab.active {
    color: #ffffff;
    background-color: var(--color-dark-bg);
  }

  .tab-number {
    font-size: 0.75rem;
    font-weight: 700;
    opacity: 0.8;
  }

  .modality-card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .modality-card-grid {
      grid-template-columns: 1fr 1.15fr;
      gap: 2.5rem;
    }
  }

  .modality-image-wrap {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 16px rgba(12, 34, 31, 0.08);
  }

  .modality-photo {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    aspect-ratio: 3 / 2;
  }

  .modality-badge-overlay {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(12, 34, 31, 0.92);
    color: #ffffff;
    padding: 0.4rem 0.85rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .badge-icon {
    color: #27ae60;
  }

  .modality-kicker {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.4rem;
  }

  .modality-title {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.3;
    margin-bottom: 0.85rem;
    color: var(--color-text);
  }

  .modality-lead {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .modality-spec-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 500px) {
    .modality-spec-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .spec-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 0.2rem;
  }

  .spec-value {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .modality-indications-wrap {
    margin-bottom: 1.75rem;
  }

  .indications-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .indications-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .indication-pill {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .modality-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>

